# Copy this file to .env and fill in the required values before running
# `make docker-up` or `docker compose up`.

# --- App (APP_*) ---
# Once this address registers, it's granted the "admin" role on every
# startup (idempotent) — see internal/bootstrap.SeedAdmin.
ADMIN_EMAIL=admin@example.com
LOG_LEVEL=DEBUG

# --- EzAuth (EZAUTH_*, read directly by the library) ---
# Required — generate with e.g. `openssl rand -hex 32`.
EZAUTH_API_KEY=change-me-api-key
# EzAuth requires this to be at least 32 characters (HS256 signing key).
EZAUTH_JWT_SECRET=change-me-jwt-secret-at-least-32-characters-long
