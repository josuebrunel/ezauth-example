package views

import "github.com/josuebrunel/ezauth"

templ ForgotPassword(auth *ezauth.EzAuth) {
	@Layout(auth, "Forgot password") {
		<article style="max-width: 28rem; margin: 2rem auto;">
			<header><h2>Forgot your password?</h2></header>
			<p>Enter your email and we'll send you a reset link. In this example, check <a href="http://localhost:8025" target="_blank" rel="noreferrer">Mailpit</a> to view it.</p>
			<form method="post" action="/auth/password-reset/request">
				<label>
					Email
					<input type="email" name="email" required autofocus/>
				</label>
				<button type="submit">Send reset link</button>
			</form>
			<footer>
				<a href="/login">Back to login</a>
			</footer>
		</article>
	}
}
